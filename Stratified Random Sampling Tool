var Utils = {

  validateNumber: function(value, min, max, name) {
    var num = parseFloat(value);
    if (isNaN(num) || num < min || num > max) {
      return {valid: false, message: name + ' must be between ' + min + ' and ' + max};
    }
    return {valid: true, value: num};
  },

  formatNumber: function(num, decimals) {
    decimals = decimals !== undefined ? decimals : 2;
    if (num === null || num === undefined) return 'N/A';
    return num.toLocaleString('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals
    });
  },

  calculateZScore: function(confidencePercent) {
    if (confidencePercent === 90) return 1.645;
    if (confidencePercent === 95) return 1.960;
    if (confidencePercent === 99) return 2.576;
    var alpha = 1 - (confidencePercent / 100);
    return 2.41 + (-10.9 * alpha) + (37.7 * Math.pow(alpha, 2)) - (57.9 * Math.pow(alpha, 3));
  },

  // ── Sample size: single-population Eq. 5 with CONFIG priors ──────────────────
  // Small area: σ = prior_mean × CV  (user-adjustable slider)
  // Large area: σ = prior_stdDev × log10_scalar  (scalar based on total AOI area)
  //
  // Eq. 5 (single population):
  //   n = (N × σ²) / (N × (E/z)² + σ²)
  //
  // This is asymptotic in N (large areas don't keep growing to infinity under
  // a homogeneous assumption), but the log10 scalar on σ in large area mode
  // lifts the ceiling as a function of area — sitting between the flat asymptote
  // and a linear growth.
  //
  // NOTE: Neyman allocation code is preserved below (commented) for future use.
  calculateN: function(totalAreaHa, carbonType, confidence, marginOfErrorPercent) {
    var prior      = CONFIG.DEFAULTS[carbonType];
    var plotSizeHa = carbonType === 'forest' ? CONFIG.FOREST_PLOT_SIZE_HA : CONFIG.SOIL_PLOT_SIZE_HA;
    var z          = this.calculateZScore(confidence);
    var E          = prior.mean * (marginOfErrorPercent / 100);
    var N          = totalAreaHa / plotSizeHa;

    var sigma;
    if (AppState.areaMode === 'small') {
      // CV mode: user defines how variable they expect the area to be
      sigma = prior.mean * AppState.currentCV;
    } else {
      // Large area: log10 scalar on prior stdDev
      // scalar at threshold = 1×, at 10× threshold = 2×, at 100× = 3×, etc.
      var scalar = Math.max(1, 1 + Math.log(totalAreaHa / CONFIG.AREA_THRESHOLD_HA) / Math.LN10);
      sigma = prior.stdDev * scalar;
      print('Large area scalar: ' + scalar.toFixed(3) +
            '\u00d7 (total area = ' + Utils.formatNumber(totalAreaHa, 0) + ' ha)');
    }

    var n = (N * Math.pow(sigma, 2)) /
            (N * Math.pow(E / z, 2) + Math.pow(sigma, 2));

    print('Prior mean: ' + prior.mean + '  sigma: ' + sigma.toFixed(3) +
          '  E: ' + E.toFixed(3) + '  N: ' + Math.round(N) + '  raw n: ' + n.toFixed(2));

    return {
      n:     Math.ceil(Math.max(CONFIG.MIN_TOTAL_SAMPLES, Math.min(n, CONFIG.MAX_TOTAL_SAMPLES))),
      sigma: sigma,
      E:     E,
      N:     N
    };
  },

  // ── Proportional allocation by stratum area ───────────────────────────────────
  // ni = n × (areaHa_i / totalAreaHa)
  // Largest-remainder rounding ensures integers sum to exactly n.
  //
  // ── NEYMAN ALLOCATION (preserved for future use) ──────────────────────────────
  // Neyman optimal: ni = n × (Ni × σi) / Σ(Nj × σj)
  // Re-enable by replacing the proportional block below with:
  //
  //   var sum_Ni_Si = allocationPlan.reduce(function(s, x) {
  //     return s + x.Ni * x.sigma;
  //   }, 0);
  //   allocationPlan.forEach(function(s) {
  //     s.exactProportion = (s.Ni * s.sigma) / sum_Ni_Si;
  //   });
  //
  // σi would need to come from per-stratum raster stats or per-stratum CV.
  allocateProportional: function(allocationPlan, totalN, totalAreaHa) {
    // Assign exact proportions by area
    allocationPlan.forEach(function(s) {
      s.exactProportion = s.areaHa / totalAreaHa;
    });

    // Largest-remainder rounding
    var withRemainders = allocationPlan.map(function(s, i) {
      var exact   = s.exactProportion * totalN;
      var floored = Math.floor(exact);
      return {index: i, floored: floored, remainder: exact - floored};
    });

    allocationPlan.forEach(function(s, i) {
      s.points = Math.max(CONFIG.MIN_SAMPLES_PER_STRATUM, withRemainders[i].floored);
    });

    var currentSum = allocationPlan.reduce(function(sum, s) { return sum + s.points; }, 0);
    var remaining  = totalN - currentSum;

    withRemainders.sort(function(a, b) { return b.remainder - a.remainder; });
    for (var i = 0; i < remaining && i < withRemainders.length; i++) {
      allocationPlan[withRemainders[i].index].points += 1;
    }

    return allocationPlan;
  },

  // ── Power-law (size-adjusted) allocation ──────────────────────────────────────
  // ni ∝ areaHa_i^α  where α = CONFIG.ALLOCATION_POWER (default 0.75)
  // α=1 → identical to proportional. α=0.5 → square-root (compromise allocation).
  // Largest-remainder rounding applied so integers sum to exactly totalN.
  // Total n is held constant at totalN — only the distribution across zones changes.
  allocatePowerLaw: function(allocationPlan, totalN, alpha) {
    var alpha = (alpha !== undefined) ? alpha : CONFIG.ALLOCATION_POWER;

    // Compute area^α weights
    var weights = allocationPlan.map(function(s) {
      return Math.pow(s.areaHa, alpha);
    });
    var sumWeights = weights.reduce(function(a, b) { return a + b; }, 0);

    // Assign exact proportions from power-law weights
    allocationPlan.forEach(function(s, i) {
      s.adjProportion = weights[i] / sumWeights;
    });

    // Largest-remainder rounding
    var withRemainders = allocationPlan.map(function(s, i) {
      var exact   = s.adjProportion * totalN;
      var floored = Math.floor(exact);
      return {index: i, floored: floored, remainder: exact - floored};
    });

    allocationPlan.forEach(function(s, i) {
      s.pointsAdj = Math.max(CONFIG.MIN_SAMPLES_PER_STRATUM, withRemainders[i].floored);
    });

    var currentSum = allocationPlan.reduce(function(sum, s) { return sum + s.pointsAdj; }, 0);
    var remaining  = totalN - currentSum;
    withRemainders.sort(function(a, b) { return b.remainder - a.remainder; });
    for (var i = 0; i < remaining && i < withRemainders.length; i++) {
      allocationPlan[withRemainders[i].index].pointsAdj += 1;
    }

    return allocationPlan;
  }
};

