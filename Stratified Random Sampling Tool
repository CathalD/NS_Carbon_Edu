    resultsPanel.add(row);
    AppState.stratumCheckboxes.push({checkbox: checkbox, stratumInfo: s});
  });

  // Totals row
  resultsPanel.add(ui.Panel([
    ui.Panel([], null, {width: '45px'}),
    ui.Label('Total', {width: '105px', fontWeight: 'bold', fontSize: '11px'}),
    ui.Panel([], null, {width: '65px'}),
    ui.Panel([], null, {width: '35px'}),
    ui.Label(String(propTotal), {width: '38px', fontWeight: 'bold', fontSize: '11px'}),
    ui.Label(String(adjTotal),  {width: '38px', fontWeight: 'bold', fontSize: '11px',
                                 color: '#1976D2'})
  ], ui.Panel.Layout.flow('horizontal'), {
    backgroundColor: '#E8E8E8', padding: '4px', margin: '2px 0 0 0'
  }));

  // Allocation selector — which column feeds into point generation
  resultsPanel.add(ui.Label('Use which allocation to generate plots?',
    {fontSize: '12px', fontWeight: 'bold', margin: '10px 4px 4px 4px'}));

  var modeSelect = ui.Select({
    items: [
      'Proportional  (equal plot density across zones)',
      'Size-adjusted  (slightly reduced density for larger zones)'
    ],
    value: AppState.allocationMode === 'adjusted'
      ? 'Size-adjusted  (slightly reduced density for larger zones)'
      : 'Proportional  (equal plot density across zones)',
    style: {stretch: 'horizontal', margin: '0 4px 0 4px'},
    onChange: function(val) {
      AppState.allocationMode = val.indexOf('Size-adjusted') !== -1 ? 'adjusted' : 'proportional';
      // Update the total points box to match selected allocation
      var total = AppState.allocationMode === 'adjusted' ? adjTotal : propTotal;
      totalPointsBox.setValue(String(total));
    }
  });
  resultsPanel.add(modeSelect);

  resultsPanel.add(ui.Label(
    'Carbon stock shown per zone is from the Canadian carbon map (display only).',
    {fontSize: '10px', color: '#aaa', margin: '6px 4px', fontStyle: 'italic'}
  ));
}

function createLegend(numClusters, suggestions) {
  legendPanel.clear();
  var schema  = getActiveSchema();
  var codes   = numClusters
    ? Array.from({length: numClusters}, function(_, i) { return i; })
    : schema.codes;
  var names   = numClusters
    ? Stratifier.generateClusterNames(numClusters, suggestions)
    : schema.names;
  var palette = numClusters
    ? Stratifier.generateClusterPalette(numClusters)
    : schema.palette;

  codes.forEach(function(code, index) {
    legendPanel.add(ui.Panel([
      ui.Label('', {backgroundColor: palette[index], padding: '10px', margin: '0 8px 0 0'}),
      ui.Label(names[index], {fontSize: '12px'})
    ], ui.Panel.Layout.flow('horizontal'), {margin: '4px 8px'}));
  });

  if (!numClusters) {
    legendPanel.add(ui.Label(
      'Excluded: urban areas, open water, bare ground and snow/ice. Cropland is available but unchecked by default.',
      {fontSize: '11px', color: '#999', margin: '8px', fontStyle: 'italic'}
    ));
  }
}

// =================================================================================
// === POINT GENERATION ============================================================
// =================================================================================

function generateStratifiedPoints() {
  var selectedStrata = AppState.stratumCheckboxes.filter(function(item) {
    return item.checkbox.getValue();
  });

  if (selectedStrata.length === 0) {
    resultsPanel.add(ui.Label('\u26a0\ufe0f Please select at least one zone.', STYLES.ERROR));
    return;
  }

  var numVal = Utils.validateNumber(
    totalPointsBox.getValue(), CONFIG.MIN_TOTAL_SAMPLES, CONFIG.MAX_TOTAL_SAMPLES, 'Total plots'
  );
  if (!numVal.valid) {
    resultsPanel.add(ui.Label(numVal.message, STYLES.ERROR));
    return;
  }

  resultsPanel.add(ui.Label('Generating plot locations\u2026', STYLES.INFO));

  var classValues = selectedStrata.map(function(item) { return item.stratumInfo.strata_code; });
  // Use points from whichever allocation column the user selected
  var classPoints = selectedStrata.map(function(item) {
    return AppState.allocationMode === 'adjusted'
      ? item.stratumInfo.pointsAdj
      : item.stratumInfo.points;
  });

  var samplingPoints = AppState.strataImage.stratifiedSample({
    numPoints:   0,
    classBand:   'strata',
    region:      AppState.currentAoi,
    scale:       CONFIG.ANALYSIS_SCALE,
    classValues: classValues,
    classPoints: classPoints,
    geometries:  true,
    seed:        CONFIG.RANDOM_SEED
  });

  samplingPoints = samplingPoints.map(function(pt) {
    return pt.set({
      'carbon_type':           AppState.currentCarbonType,
      'sampling_type':         'stratified_random',
      'stratification_method': AppState.stratificationMethod,
      'area_mode':             AppState.areaMode,
      'cv_used':               AppState.areaMode === 'small' ? AppState.currentCV : null
    });
  });

  samplingPoints.size().evaluate(function(count, error) {
    if (error) {
      resultsPanel.add(ui.Label('\u26a0\ufe0f Error: ' + error, STYLES.ERROR));
      return;
    }

    AppState.currentPoints = samplingPoints;
    var layers = map.layers();
    for (var i = layers.length() - 1; i >= 0; i--) {
      if (layers.get(i).getName().indexOf('Plot locations') !== -1) {
        map.layers().remove(layers.get(i));
      }
    }

    var color = AppState.currentCarbonType === 'forest' ? '228B22' : '8B4513';
    map.addLayer(AppState.currentPoints, {color: color}, 'Plot locations (' + count + ')');

    exportButton.setDisabled(false);
    resultsPanel.add(ui.Label(
      '\u2713 ' + count + ' plot locations generated (target: ' +
      classPoints.reduce(function(a, b) { return a + b; }, 0) + ')',
      STYLES.SUCCESS
    ));
    print('\u2713 Generated ' + count + ' plot locations');
  });
}

