function buildClassCheckboxes(schema, containerPanel) {
  containerPanel.clear();
  containerPanel.add(ui.Label('Select which land cover types to include:', STYLES.INSTRUCTION));
  schema.codes.forEach(function(code, idx) {
    // Cropland (code 1) is unchecked by default; all others are on
    var isOn = schema.defaultOn.indexOf(code) !== -1;
    var swatch = ui.Label('', {
      backgroundColor: schema.palette[idx],
      padding: '8px', margin: '0 6px 0 0',
      border: '1px solid #ccc'
    });
    var cb = ui.Checkbox({value: isOn, style: {margin: '0 4px 0 0'}});
    cb.onChange(function(checked) {
      var sel = AppState.selectedClasses;
      if (checked) {
        if (sel.indexOf(code) === -1) sel.push(code);
      } else {
        var pos = sel.indexOf(code);
        if (pos !== -1) sel.splice(pos, 1);
      }
    });
    // Mark cropland with a note
    var nameLabel = schema.names[idx];
    if (code === 1) nameLabel += ' (optional)';
    containerPanel.add(ui.Panel(
      [cb, swatch, ui.Label(nameLabel, {fontSize: '12px'})],
      ui.Panel.Layout.flow('horizontal'), {margin: '3px 0'}
    ));
  });
}

