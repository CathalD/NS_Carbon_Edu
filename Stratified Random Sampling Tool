// =================================================================================
// === 7. CORE FUNCTIONS ===========================================================
// =================================================================================

function getAoi() {
  var method = aoiSelection.getValue();
  if (method === 'Draw a polygon') {
    var layers = map.drawingTools().layers();
    if (layers.length() === 0 || layers.get(0).geometries().length() === 0) return null;
    return layers.get(0).toGeometry();
  } else {
    var assetId = assetIdBox.getValue();
    if (!assetId || assetId.trim() === '') return null;
    try { return ee.FeatureCollection(assetId.trim()).geometry(); } catch(e) { return null; }
  }
}

function getActiveSchema() {
  return AppState.esaMode === 'extended' ? ESA_EXTENDED : ESA_STANDARD;
}

function getZoneName(code, numClusters, suggestions) {
  if (numClusters) return 'Zone ' + (code + 1);
  var schema = getActiveSchema();
  var idx = schema.codes.indexOf(code);
  return idx !== -1 ? schema.names[idx] : 'Unknown';
}

// =================================================================================
// === Main analysis entry point ===================================================
// =================================================================================

function runAnalysis() {
  resultsPanel.clear();
  legendPanel.clear();
  map.layers().reset();

  AppState.currentAoi = getAoi();
  if (!AppState.currentAoi) {
    resultsPanel.add(ui.Label('\u26a0\ufe0f Please define an area of interest first.', STYLES.ERROR));
    return;
  }

  var confVal = Utils.validateNumber(confidenceBox.getValue(),    70, 99.9, 'Confidence level');
  var moeVal  = Utils.validateNumber(marginOfErrorBox.getValue(),  1, 50,   'Acceptable error');
  if (!confVal.valid) { resultsPanel.add(ui.Label(confVal.message, STYLES.ERROR)); return; }
  if (!moeVal.valid)  { resultsPanel.add(ui.Label(moeVal.message,  STYLES.ERROR)); return; }

  var stratMethod = stratMethodSelect.getValue();
  AppState.stratificationMethod = stratMethod;

  if (stratMethod.indexOf('ESA') !== -1 && AppState.selectedClasses.length === 0) {
    resultsPanel.add(ui.Label('\u26a0\ufe0f Please select at least one land cover type.', STYLES.ERROR));
    return;
  }

  resultsPanel.add(ui.Label('Working\u2026', STYLES.INFO));

  map.centerObject(AppState.currentAoi, 10);
  map.addLayer(AppState.currentAoi, {color: 'E53935'}, 'AOI');

  var carbonType = carbonTypeSelect.getValue() === 'Forest Carbon' ? 'forest' : 'soil';
  AppState.currentCarbonType = carbonType;

  map.addLayer(forestCarbon.clip(AppState.currentAoi), fcVis, 'Forest Carbon', false);
  map.addLayer(soilCarbon.clip(AppState.currentAoi),   scVis, 'Soil Carbon',   false);

  // ── ESA CCI branch ────────────────────────────────────────────────────────────
  if (stratMethod.indexOf('ESA') !== -1) {
    resultsPanel.clear();
    resultsPanel.add(ui.Label('Dividing area by land cover type\u2026', STYLES.INFO));

    var strataImg = Stratifier.createEsaCciStrata(
      AppState.currentAoi, AppState.esaMode, AppState.selectedClasses
    );
    AppState.strataImage = strataImg;
    AppState.numClusters = null;

    var hist = strataImg.reduceRegion({
      reducer:   ee.Reducer.frequencyHistogram(),
      geometry:  AppState.currentAoi,
      scale:     CONFIG.ANALYSIS_SCALE,
      maxPixels: CONFIG.MAX_PIXELS
    });

    hist.evaluate(function(result, error) {
      if (error || !result || !result.strata) {
        resultsPanel.clear();
        resultsPanel.add(ui.Label(
          '\u26a0\ufe0f Could not read land cover data for this area: ' + error, STYLES.ERROR));
        return;
      }
      var presentCodes = Object.keys(result.strata).map(Number);
      if (presentCodes.length === 0) {
        resultsPanel.clear();
        resultsPanel.add(ui.Label('\u26a0\ufe0f No selected land cover types found in this area.', STYLES.ERROR));
        return;
      }
      resultsPanel.clear();
      resultsPanel.add(ui.Label(
        'Found ' + presentCodes.length + ' zones. Calculating how many plots you need\u2026', STYLES.INFO));
      runSampleSizeCalculation(carbonType, confVal.value, moeVal.value, null, null);
    });

  // ── Google Embeddings branch ──────────────────────────────────────────────────
  } else {
    var k = AppState.fixedK;
    resultsPanel.clear();
    resultsPanel.add(ui.Label('Dividing area into ' + k + ' zones using satellite imagery\u2026', STYLES.INFO));

    Stratifier.createEmbeddingsStrata(AppState.currentAoi, k, function(strataImage, numClusters, error) {
      if (error) {
        resultsPanel.clear();
        resultsPanel.add(ui.Label('\u26a0\ufe0f Error dividing area: ' + error, STYLES.ERROR));
        return;
      }
      AppState.strataImage = strataImage;
      AppState.numClusters = numClusters;

      resultsPanel.clear();
      resultsPanel.add(ui.Label('Identifying zone characteristics\u2026', STYLES.INFO));

      Stratifier.analyzeClusterComposition(AppState.currentAoi, strataImage, function(suggestions, err) {
        runSampleSizeCalculation(carbonType, confVal.value, moeVal.value, numClusters, suggestions);
      });
    });
  }
}

// =================================================================================
// === Sample size + allocation =====================================================
// =================================================================================
//
//  1. Per-stratum reduceRegion for display stats (area, mean carbon stock)
//  2. Total n from CONFIG priors + single-population Eq.5 + area scalar
//  3. Proportional allocation by stratum area
//  (Neyman allocation preserved as comments — see Utils.allocateProportional)

function runSampleSizeCalculation(carbonType, confidence, marginOfErrorPercent, numClusters, clusterSuggestions) {
  var carbonImage = carbonType === 'forest' ? forestCarbon : soilCarbon;

  var analysisImage = carbonImage.rename('carbon')
    .addBands(AppState.strataImage)
    .clip(AppState.currentAoi);

  // Per-stratum reduceRegion — for display only (area + mean carbon stock)
  var reducer = ee.Reducer.mean()
    .combine(ee.Reducer.count(), null, true)
    .group({groupField: 1, groupName: 'strata_code'});

  var stats = analysisImage.reduceRegion({
    reducer:   reducer,
    geometry:  AppState.currentAoi,
    scale:     CONFIG.ANALYSIS_SCALE,
    maxPixels: CONFIG.MAX_PIXELS,
    tileScale: 4
  });

  stats.evaluate(function(statsDict, error) {
    resultsPanel.clear();

    if (error || !statsDict || !statsDict.groups || statsDict.groups.length === 0) {
      resultsPanel.add(ui.Label(
        '\u26a0\ufe0f Could not calculate zone statistics: ' + (error || 'No valid zones found'),
        STYLES.ERROR));
      return;
    }

    var groups = statsDict.groups;

    // Build display-only stratum records from raster
    var strataDisplay = groups.map(function(g) {
      var areaHa = (g.count * CONFIG.ANALYSIS_SCALE * CONFIG.ANALYSIS_SCALE) / 10000;
      return {
        code:        g.strata_code,
        areaHa:      areaHa,
        meanCarbon:  (g.mean !== null && g.mean !== undefined) ? g.mean : null
      };
    });

    // Total area from summed pixel counts (more accurate than geometry.area for this)
    var totalAreaHa = strataDisplay.reduce(function(sum, s) { return sum + s.areaHa; }, 0);

    // ── Sample size from CONFIG priors (single population Eq.5) ──────────────
    var nResult = Utils.calculateN(totalAreaHa, carbonType, confidence, marginOfErrorPercent);
    var final_n = nResult.n;

    // ── Proportional allocation ────────────────────────────────────────────────
    var allocationPlan = strataDisplay.map(function(s) {
      return {
        strata_code: s.code,
        areaHa:      s.areaHa,
        meanCarbon:  s.meanCarbon,
        exactProportion: 0,
        points:          0
      };
    });

    // Run both allocations — proportional and power-law — storing results on each
    // stratum object as s.points (proportional) and s.pointsAdj (size-adjusted).
    AppState.allocationInfo = Utils.allocateProportional(allocationPlan, final_n, totalAreaHa);
    AppState.allocationInfo = Utils.allocatePowerLaw(AppState.allocationInfo, final_n);

    var propTotal = AppState.allocationInfo.reduce(function(sum, s) { return sum + s.points; }, 0);
    var adjTotal  = AppState.allocationInfo.reduce(function(sum, s) { return sum + s.pointsAdj; }, 0);
    var adjustedTotal = propTotal;  // summary header always shows proportional total
    AppState.calculatedSampleSize = propTotal;

    // ── Summary display ────────────────────────────────────────────────────────
    var modeStr = AppState.areaMode === 'small'
      ? 'Smaller project \u2013 variability ' + (AppState.currentCV * 100).toFixed(0) + '%'
      : 'Larger project \u2013 area-adjusted estimate';

    var schemaLabel = numClusters
      ? 'Satellite imagery zones (' + numClusters + ' zones)'
      : (AppState.esaMode === 'extended'
          ? 'Land cover map \u2013 detailed (8 types)'
          : 'Land cover map \u2013 standard (6 types)');

    var summaryPanel = ui.Panel([
      ui.Label(adjustedTotal + ' Total Plots', {
        fontSize: '24px', fontWeight: 'bold', color: '#005931', margin: '4px 0'
      }),
      ui.Label(modeStr,      {fontSize: '11px', color: '#666'}),
      ui.Label('Method: ' + schemaLabel, {fontSize: '11px', color: '#666'}),
      ui.Label('Estimated carbon stock: ' + Utils.formatNumber(nResult.E / (marginOfErrorPercent/100), 2) +
               ' t/ha (Canada-wide prior)',  {fontSize: '11px', color: '#666'}),
      ui.Label('Target precision: \u00b1' + Utils.formatNumber(nResult.E, 2) + ' t/ha',
               {fontSize: '11px', color: '#666'}),
      ui.Label('Total area: ' + Utils.formatNumber(totalAreaHa, 1) + ' ha across ' +
               strataDisplay.length + ' zones', {fontSize: '11px', color: '#666'})
    ], null, {border: '2px solid #005931', padding: '12px', margin: '8px 0'});

    resultsPanel.add(summaryPanel);

    displayAllocationPlan(AppState.allocationInfo, propTotal, adjTotal, numClusters, clusterSuggestions);
    createLegend(numClusters, clusterSuggestions);

    // Map layer
    var schema  = getActiveSchema();
    var palette = numClusters ? Stratifier.generateClusterPalette(numClusters) : schema.palette;
    // min=1 because ESA CCI remapped values start at 1 (0 is masked).
    // max = last code value (5 for standard, 7 for extended).
    // Clusters start at 0, so min=0 for those.
    var minVal  = numClusters ? 0 : 1;
    var maxVal  = numClusters ? numClusters - 1 : schema.codes[schema.codes.length - 1];
    map.addLayer(AppState.strataImage, {min: minVal, max: maxVal, palette: palette}, 'Zones');

    totalPointsBox.setValue(adjustedTotal.toString());
    generateButton.setDisabled(false);

    print('\u2500\u2500\u2500 Sample Size Summary \u2500\u2500\u2500');
    print('Mode: ' + modeStr);
    print('Total area: ' + Utils.formatNumber(totalAreaHa, 1) + ' ha');
    print('n (Eq.5, single population): ' + final_n);
    print('After rounding (proportional): ' + propTotal);
    print('After rounding (size-adjusted α=0.75): ' + adjTotal);
    print('\u2500\u2500\u2500 Zone Allocation (proportional) \u2500\u2500\u2500');
    AppState.allocationInfo.forEach(function(s) {
      var label = getZoneName(s.strata_code, numClusters, clusterSuggestions);
      print(label + ':  area=' + Utils.formatNumber(s.areaHa,0) + ' ha' +
            '  prop=' + s.points +
            '  adj=' + s.pointsAdj);
    });
  });
}

