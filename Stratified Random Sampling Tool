// === 5. STRATIFICATION METHODS ===================================================
// =================================================================================

var Stratifier = {

  // ── ESA CCI strata ─────────────────────────────────────────────────────────────
  createEsaCciStrata: function(aoi, mode, selectedClasses) {
    var schema = mode === 'extended' ? ESA_EXTENDED : ESA_STANDARD;
    var strata = esaCciLandcover
      .remap(schema.from, schema.to, 0)
      .rename('strata');

    // Mask excluded codes (0) and user-deselected classes
    var validMask = strata.neq(0);
    if (selectedClasses && selectedClasses.length > 0) {
      var selMask = strata.eq(selectedClasses[0]);
      for (var i = 1; i < selectedClasses.length; i++) {
        selMask = selMask.or(strata.eq(selectedClasses[i]));
      }
      validMask = validMask.and(selMask);
    }
    return strata.updateMask(validMask).clip(aoi);
  },

  // ── Google Embeddings – fixed-k clustering ─────────────────────────────────────
  createEmbeddingsStrata: function(aoi, k, callback) {
    var embeddings = ee.ImageCollection("GOOGLE/SATELLITE_EMBEDDING/V1/ANNUAL")
      .filterBounds(aoi)
      .filterDate('2023-01-01', '2024-01-01')
      .mosaic()
      .clip(aoi);

    var trainingSample = embeddings.sample({
      region:    aoi,
      scale:     CONFIG.EMBEDDINGS_SCALE,
      numPixels: CONFIG.TRAINING_PIXELS,
      seed:      CONFIG.RANDOM_SEED,
      geometries: true
    });

    var clusterer = ee.Clusterer.wekaKMeans({
      nClusters: k,
      seed:      CONFIG.RANDOM_SEED
    }).train(trainingSample);

    var rawClassified = embeddings.cluster(clusterer);

    var hist = rawClassified.reduceRegion({
      reducer:   ee.Reducer.frequencyHistogram(),
      geometry:  aoi,
      scale:     CONFIG.EMBEDDINGS_SCALE * 5,
      maxPixels: CONFIG.MAX_PIXELS,
      tileScale: 4
    });

    hist.evaluate(function(result, error) {
      if (error) { callback(null, null, error); return; }
      var clusterCounts = result.cluster;
      if (!clusterCounts) {
        callback(null, null, 'No valid data found in AOI for clustering.');
        return;
      }
      var originalIds = Object.keys(clusterCounts).map(Number)
        .sort(function(a, b) { return a - b; });
      var count  = originalIds.length;
      var newIds = [];
      for (var i = 0; i < count; i++) newIds.push(i);
      var remapped = rawClassified.remap(originalIds, newIds).rename('strata');
      callback(remapped.reproject({crs: 'EPSG:4326', scale: CONFIG.ANALYSIS_SCALE}).clip(aoi), count, null);
    });
  },

  // Cross-tabulate clusters against ESA CCI Standard to suggest zone names
  analyzeClusterComposition: function(aoi, strataImage, callback) {
    var simplified = esaCciLandcover
      .remap(ESA_STANDARD.from, ESA_STANDARD.to, 0)
      .rename('landcover_class');

    var combined = strataImage.addBands(simplified);
    var stats = combined.reduceRegion({
      reducer:   ee.Reducer.frequencyHistogram().group({groupField: 0, groupName: 'cluster_id'}),
      geometry:  aoi,
      scale:     CONFIG.ANALYSIS_SCALE,
      maxPixels: 1e13,
      tileScale: 4
    });

    stats.evaluate(function(result, error) {
      if (error) { callback(null, error); return; }
      var suggestions = {};
      var groups = result.groups;
      if (groups) {
        groups.forEach(function(g) {
          var histogram = g.histogram;
          var dominantClass = null;
          var maxCount = -1;
          for (var lcClass in histogram) {
            if (histogram[lcClass] > maxCount) {
              maxCount = histogram[lcClass];
              dominantClass = parseInt(lcClass);
            }
          }
          var nameIndex = ESA_STANDARD.codes.indexOf(dominantClass);
          suggestions[g.cluster_id] = nameIndex !== -1 ? ESA_STANDARD.names[nameIndex] : 'Unknown';
        });
      }
      callback(suggestions, null);
    });
  },

  generateClusterPalette: function(n) {
    return ['#e41a1c','#377eb8','#4daf4a','#984ea3','#ff7f00',
            '#ffff33','#a65628','#f781bf','#999999','#66c2a5'].slice(0, n);
  },

  generateClusterNames: function(n, suggestions) {
    var names = [];
    for (var i = 0; i < n; i++) {
      var name = 'Zone ' + (i + 1);
      if (suggestions && suggestions[i]) name += ' (' + suggestions[i] + '?)';
      names.push(name);
    }
    return names;
  }
};

